{
  "name": "tacai-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:stg": "vite --mode staging",
    "dev:prd": "vite --mode production",
    "build": "vue-tsc --noEmit && vite build",
    "build:stg": "vue-tsc --noEmit && vite build --mode staging",
    "build:prd": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.7.0",
    "element-plus": "^2.14.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-i18n": "^9.13.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vue-tsc": "^2.0.0"
  }
}
